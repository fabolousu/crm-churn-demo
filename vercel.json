{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@12.21.0 --dir web install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.21.0 --dir web build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
